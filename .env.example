# --- Postiz (self-hosted, run separately; this repo only talks to its API) ---
# Whatever NEXT_PUBLIC_BACKEND_URL / BACKEND_INTERNAL_URL your Postiz instance uses.
POSTIZ_BASE_URL=http://localhost:3000
# Postiz dashboard -> Settings -> Public API -> generate key.
# Sent verbatim as the "Authorization" header (no "Bearer" prefix).
POSTIZ_API_KEY=

# --- Local-first inference (tried first) ---
# Any OpenAI-compatible endpoint. Ollama example:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Fallback inference (used only if the local endpoint is unreachable,
# and only for brands with `allow_cloud_fallback: true` in their org YAML) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Director's Telegram channel (human-facing only: escalations, daily
# progress, monetization summaries) -- BotFather issues the token, the chat
# id is your own user/chat id. Leave both blank to disable; Director is a
# safe no-op without them. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ops ticketing via email (fallback usage, local-inference outages,
# ambiguous publishes, Secretary/DevOps findings) -- any real SMTP provider.
# Leave SMTP_HOST blank to disable; Director is a safe no-op without it. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_TO_ADDR=
SMTP_USE_TLS=true
