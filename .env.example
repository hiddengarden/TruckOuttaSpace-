# --- Postiz (self-hosted, run separately; this repo only talks to its API) ---
# Whatever NEXT_PUBLIC_BACKEND_URL / BACKEND_INTERNAL_URL your Postiz instance uses.
# If deployed via deploy/systemd/postiz.container (see deploy/README.md),
# that's http://localhost:5000 -- the app's own internal port, reachable
# directly since that stack uses host networking.
POSTIZ_BASE_URL=http://localhost:5000
# Postiz dashboard -> Settings -> Public API -> generate key.
# Sent verbatim as the "Authorization" header (no "Bearer" prefix).
POSTIZ_API_KEY=

# --- Local-first inference (tried first) ---
# Any OpenAI-compatible endpoint. Ollama example:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Fallback inference (used only if the local endpoint is unreachable,
# and only for brands with `allow_cloud_fallback: true` in their org YAML) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Director's Telegram channel (human-facing only: escalations, daily
# progress, monetization summaries) -- BotFather issues the token, the chat
# id is your own user/chat id. Leave both blank to disable; Director is a
# safe no-op without them. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ops ticketing via email (fallback usage, local-inference outages,
# ambiguous publishes, Secretary/DevOps findings) -- any real SMTP provider.
# Leave SMTP_HOST blank to disable; Director is a safe no-op without it. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_TO_ADDR=
SMTP_USE_TLS=true

# --- Data roots ---
# All default to relative paths (./knowledge, ./state, etc.), which land
# under wherever the process's working directory is -- for
# agency-run-all.service/loop that's %h/agency, i.e. the SAME shared OS
# partition (`%h` itself) the whole point of discover_environment.py was to
# avoid filling up. Point these at the separate NVMe `Storage` drive
# instead, matching deploy/README.md's convention for Postiz/WordPress's
# own volumes. Adjust the home directory in these paths if yours differs.
KNOWLEDGE_ROOT=/var/home/truckouttaspace/Storage/agency-stack/agency/knowledge
STATE_ROOT=/var/home/truckouttaspace/Storage/agency-stack/agency/state
CHECKPOINT_DB_PATH=/var/home/truckouttaspace/Storage/agency-stack/agency/state/checkpoints.db
ASSETS_ROOT=/var/home/truckouttaspace/Storage/agency-stack/agency/assets
CONTENT_ROOT=/var/home/truckouttaspace/Storage/agency-stack/agency/content
# org/ and workflows/ are small (config + JSON graphs, no generated media)
# and stay under the code checkout at %h/agency -- no need to relocate them.
ORG_DIR=./org
WORKFLOWS_DIR=./workflows/image
VIDEO_WORKFLOWS_DIR=./workflows/video
AUDIO_WORKFLOWS_DIR=./workflows/audio

# --- ComfyUI (already running with GPU passthrough on this host) ---
COMFYUI_BASE_URL=http://localhost:8188

# --- Scheduled run-all/loop cadence ---
RUN_INTERVAL_SECONDS=21600
