# Temporal (which Postiz's app depends on) owns a SEPARATE Postgres
# database from postiz-postgres -- kept as its own env file rather than
# reusing postiz.env.example's POSTGRES_USER/POSTGRES_PASSWORD, since those
# two Postgres instances have no reason to share credentials.
#
#   cp deploy/postiz-temporal-postgres.env.example ~/agency-stack/secrets/postiz-temporal-postgres.env
#   chmod 600 ~/agency-stack/secrets/postiz-temporal-postgres.env

POSTGRES_USER=temporal
POSTGRES_PASSWORD=
