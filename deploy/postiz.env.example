# Copy this to a secrets location OUTSIDE the repo (never commit real
# secrets), then point every deploy/systemd/postiz-*.container unit's
# EnvironmentFile= at it:
#
#   mkdir -p ~/agency-stack/secrets
#   cp deploy/postiz.env.example ~/agency-stack/secrets/postiz.env
#   chmod 600 ~/agency-stack/secrets/postiz.env
#   # fill in the blanks below
#
# All containers in this stack use `Network=host` (per the discovery
# script's live test + your explicit choice), so every service is reachable
# at 127.0.0.1:<port> with no container-to-container DNS involved -- these
# URLs use 127.0.0.1 for exactly that reason.

# --- postiz-postgres ---
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=
POSTGRES_DB=postiz-db-local

# --- postiz app ---
# Same user/password/db as above, just as a connection string.
DATABASE_URL=postgresql://postiz-user:REPLACE_WITH_SAME_PASSWORD_AS_ABOVE@127.0.0.1:5432/postiz-db-local
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
# The postiz-app container image listens on 5000 internally; with host
# networking that's also the host-facing port (no publish-port translation
# happens in host mode) -- 5000 was free on this host per discover_environment.py.
MAIN_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api
# Verbatim from upstream's own reference compose, which points this at
# :3000 even though the app's public port is :5000/4007 elsewhere in the
# same file -- kept as-is rather than "corrected" since the actual reason
# isn't documented and matching a known-working reference is safer than
# guessing. If postiz logs an internal-connection error on startup, this is
# the first thing to check.
BACKEND_INTERNAL_URL=http://localhost:3000
TEMPORAL_ADDRESS=127.0.0.1:7233
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads

# Social platform API keys -- add only what you actually connect.
# Full list: https://docs.postiz.com (X_API_KEY, LINKEDIN_CLIENT_ID,
# REDDIT_CLIENT_ID, GITHUB_CLIENT_ID, THREADS_APP_ID, FACEBOOK_APP_ID,
# YOUTUBE_CLIENT_ID, TIKTOK_CLIENT_ID, PINTEREST_CLIENT_ID,
# DISCORD_CLIENT_ID, SLACK_ID, MASTODON_URL, ...and each one's *_SECRET).
