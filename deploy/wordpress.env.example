# Same pattern as postiz.env.example -- copy outside the repo, fill in,
# chmod 600:
#   cp deploy/wordpress.env.example ~/agency-stack/secrets/wordpress.env
#
# Unlike the rest of the stack, WordPress + its database are on their own
# private bridge network (wordpress.network), not host networking -- see
# that file's comment for why. WORDPRESS_DB_HOST is set directly in
# wordpress.container (as the container name "wordpress-db"), not here.

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Same user/password/db as above -- the wordpress image and the mariadb
# image each expect their own env var names for identical values.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=
